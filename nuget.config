<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="nuget.legacyhash" value="true" />
  </config>
  <packageSources>
    <clear />
    <!-- Only use local cache, no remote sources -->
  </packageSources>
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
</configuration>
