<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArtasTools.MonitorAgent</AssemblyName>
    <RootNamespace>ArtasTools.MonitorAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Abstractions\ArtasTools.MonitorAgent.Abstractions.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Core\ArtasTools.MonitorAgent.Core.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Llm\ArtasTools.MonitorAgent.Llm.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Infrastructure\ArtasTools.MonitorAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Context\ArtasTools.MonitorAgent.Context.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Roslyn\ArtasTools.MonitorAgent.Roslyn.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.CodeChange\ArtasTools.MonitorAgent.CodeChange.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Agent\ArtasTools.MonitorAgent.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
