# =============================================================================
# ArtasTools.MonitorAgent (LLMMetrics) — шаблон переменных окружения (запуск на хосте)
# =============================================================================
# Копирование в рабочий файл:
#   Copy-Item src/LLMMetrics/.env.example src/LLMMetrics/.env
#
# Имена с двойным подчёркиванием мапятся в секции appsettings.json:
#   LLM__PROVIDER              -> Llm:Provider
#   AGENT__WINDOWHOURS         -> Agent:WindowHours
#   Loki__BaseUrl              -> Loki:BaseUrl
#   Context__Sources__local-folder__Path -> Context:Sources:local-folder:Path
#
# ТРИ ОСОБЕННОСТИ ПАРСЕРА .env (run_LLMMetrics.ps1 / run_Writer.ps1 / run_Stat.ps1):
#   1. Инлайн-комментарии НЕ срезаются: "KEY=value  # коммент" даст значение
#      "value  # коммент". Комментарий — только отдельной строкой.
#   2. Переменная, уже заданная в окружении процесса, НЕ перезаписывается.
#      Поэтому .env из каталога скрипта грузится первым и имеет приоритет
#      над корневым .env.
#   3. Кавычки вокруг значения обрезаются; экранирование не поддерживается.
#
# ЭТОТ ФАЙЛ — ЕДИНСТВЕННЫЙ ШАБЛОН КОНФИГУРАЦИИ АГЕНТА В РЕПОЗИТОРИИ.
# Он описывает запуск агента НА ХОСТЕ (Windows): Loki/Prometheus через localhost,
# пути локальные, отчёты в reports/.
#
# Docker-ветка (deploy/monitor-agent/docker-compose.monitor-agent.yml) требует
# СВОЙ файл deploy/monitor-agent/monitor-agent.env (директива env_file), но
# шаблона для него намеренно нет: значения там отличаются (сервисы по именам
# контейнеров loki/prometheus, пути внутри образа /app и /reports/monitoring)
# и второй шаблон неизбежно разошёлся бы с этим. При необходимости Docker-версия
# собирается из значений ниже: BaseUrl -> http://loki:3100 / http://prometheus:9090,
# каталоги -> /reports/monitoring, ROSLYN__ENABLED=false (в runtime-образе нет MSBuild SDK).
# =============================================================================


# --- LLM: транспорт ----------------------------------------------------------
# custom — собственный HttpClient (полный контроль JSON-схемы и ретраев),
# meai   — Microsoft.Extensions.AI 10.5.0.
# Обе ветки требуют OpenAI-совместимый /v1/chat/completions.
LLM__PROVIDER=custom

# Базовый URL провайдера. Клиент сам постит на относительный
# "/v1/chat/completions", поэтому достаточно корня API.
# Примеры:
#   https://api.openai.com
#   https://openrouter.ai/api
#   http://localhost:11434/v1              (Ollama)
#   http://localhost:1234/v1               (LM Studio)
#   https://gigacode.ru/api/openai/v1      (GigaCode)
LLM__ENDPOINT=https://api.openai.com

# API-ключ провайдера (заголовок Authorization: Bearer <ключ>).
# СЕКРЕТ: кладите только в .env, никогда не коммитьте (см. .gitignore).
LLM__APIKEY=ЗАМЕНИТЕ_НА_КЛЮЧ

# Модель. Для слабой/локальной модели отчёт будет беднее.
LLM__MODEL=gpt-4.1-mini

# Лимиты генерации и транспорта.
LLM__MAXTOKENS=4000
LLM__TEMPERATURE=0.1
LLM__TIMEOUTSECONDS=120
LLM__MAXRETRIES=3


# --- Окно анализа и расписание ----------------------------------------------
# ВСЁ по UTC (см. .roo/rules/01-general.md): границы окна, дни, метки времени.
# МСК используется только для отображения времени человеком.

# Время ночного запуска планировщика (формат HH:mm, UTC).
AGENT__RUNATUTC=03:00

# Глубина окна анализа в часах от текущего момента назад.
AGENT__WINDOWHOURS=24

# Сколько уникальных ошибок попадать в сводку для LLM.
AGENT__TOPERRORSLIMIT=25

# Максимальная длина одного сэмпла ошибки в символах (редопа/тримминг).
AGENT__MAXSAMPLECHARS=2000

# Сколько дней хранить историю прогонов в SQLite (PurgeOldRuns).
AGENT__RETENTIONDAYS=90


# --- Оркестратор агента ------------------------------------------------------
# native          — собственный ReAct-цикл поверх Microsoft.Extensions.AI.
# semantic-kernel — SK 1.81.0; ТРЕБУЕТ, чтобы AddSemanticKernelOrchestrator()
#                   был вызван в DependencyInjection (сейчас НЕ вызывается),
#                   иначе запуск упадёт с InvalidOperationException.
AGENT__ORCHESTRATION__ORCHESTRATOR=native

# Максимум шагов ReAct-цикла (один шаг = один ответ модели).
AGENT__ORCHESTRATION__MAXSTEPS=8

# Максимум вызовов инструментов за прогон (защита от зацикливания).
AGENT__ORCHESTRATION__TOOLCALLLIMIT=30

# Строить ли план правки. false — только диагностика.
AGENT__ORCHESTRATION__ENABLEFIXPLANNING=true


# --- Каталоги ----------------------------------------------------------------
# Для запуска на хосте используйте АБСОЛЮТНЫЕ пути: относительные разрешаются
# от рабочего каталога процесса и зависят от способа запуска.
# По умолчанию каталог логов агента — <ReportsDir>\logs (НЕ общий LOGS_DIR,
# чтобы Promtail не индексировал вывод агента в Loki).

AGENT__REPORTSDIR=D:\work\Artas2026\reports\monitoring
AGENT__DATABASEPATH=D:\work\Artas2026\reports\monitoring\facts.db


# --- Health-эндпоинт ---------------------------------------------------------
# Даёт GET /health и GET /status. Порт должен быть СВОБОДЕН:
# 8080 занят Writer'ом, поэтому агенту берём другой.
AGENT__HEALTHPORT=8091


# --- Внешние источники фактов ------------------------------------------------
# На хосте (не в Docker) Loki/Prometheus доступны по localhost — они
# публикуют порты на 127.0.0.1 (см. monitoring/docker-compose.monitoring.yml).
# Внутри контейнера вместо localhost имена сервисов: http://loki:3100,
# http://prometheus:9090.

Loki__BaseUrl=http://localhost:3100
Loki__TimeoutSeconds=30
Loki__MaxEntries=500

Prometheus__BaseUrl=http://localhost:9090
Prometheus__TimeoutSeconds=30


# --- Контекст: документация проекта ------------------------------------------
# Этап 1 — единственный источник: локальная папка с Markdown.
# Новый источник (Confluence/Jira/pgvector) = реализация IContextSource
# + одна строка services.AddContextSource<T>() в DependencyInjection.

CONTEXT__ENABLED=true

# Сколько документов отбирает каждый источник.
CONTEXT__TOPK=8

# Бюджет символов: на один документ и на весь контекст сразу.
CONTEXT__MAXCHARS=6000
CONTEXT__TOTALCHARSBUDGET=24000

# Каталог документации. Относительный путь разрешается от рабочего каталога
# процесса, поэтому на хосте указывайте абсолютный.
# ИМЯ СЕКЦИИ СОДЕРЖИТ ДЕФИС (local-folder) — в имени переменной окружения
# он сохраняется как есть (нижнее подчёркивание его НЕ заменяет).
Context__Sources__local-folder__Path=D:\work\Artas2026\docs

# Массивы из .env — через индекс после "__": __0, __1, ...
CONTEXT__SOURCES__LOCAL_FOLDER__INCLUDE__0=**/*.md

Context__Sources__local-folder__MaxFiles=2000
Context__Sources__local-folder__MaxFileBytes=524288
Context__Sources__local-folder__ChunkSize=3000
Context__Sources__local-folder__ChunkOverlap=300


# --- Анализ кода (Roslyn / MSBuildWorkspace) ---------------------------------
# ТРЕБУЕТ полный MSBuild SDK в процессе. На хосте с .NET SDK работать может,
# но загрузка решения дорогая (десятки секунд) и чувствительна к офлайн-NuGet.
# Безопасный дефолт — false: агент продолжает диагностику без инструментов
# чтения кода. Включается флагом раннера: run_LLMMetrics.ps1 -Roslyn
ROSLYN__ENABLED=false

# Решение (.slnx/.sln) или проект (.csproj) для загрузки компиляции.
ROSLYN__SOLUTIONPATH=D:\work\Artas2026\src\Tools\ArtasTools.slnx

ROSLYN__COMPILATIONCACHESECONDS=300
ROSLYN__MAXSOURCECHARS=20000
ROSLYN__MAXSEARCHRESULTS=50


# --- Применение правок (git + build + test + коммит) -------------------------
# Безопасный дефолт — false. При включении агент:
#   создаёт ветку fix/ai-{runId}, применяет правки через AST,
#   прогоняет dotnet build + dotnet test, коммитит при успехе.
# PUSH НЕ ВЫПОЛНЯЕТСЯ — мерж только вручную.
# Включается флагом раннера: run_LLMMetrics.ps1 -CodeChange
CODECHANGE__ENABLED=false

# Корень git-репозитория.
CODECHANGE__REPOSITORYPATH=D:\work\Artas2026

# БАЗОВАЯ ВЕТКА: проверьте фактическую ("git rev-parse --abbrev-ref HEAD").
# В этом репозитории — master, НЕ main.
CODECHANGE__BASEBRANCH=master

# Отказываться от правок при грязном рабочем дереве.
CODECHANGE__REQUIRECLEANWORKTREE=true

CODECHANGE__BUILDTIMEOUTSECONDS=600
CODECHANGE__TESTTIMEOUTSECONDS=900
CODECHANGE__SKIPTESTS=false
CODECHANGE__SOLUTIONPATH=D:\work\Artas2026\src\Tools\ArtasTools.slnx
CODECHANGE__GITEXECUTABLE=git
CODECHANGE__DOTNETEXECUTABLE=dotnet
CODECHANGE__BRANCHPREFIX=fix/ai-


# --- Единый каталог логов Artas2026 ------------------------------------------
# Используется раннером как каталог общих логов (Writer/Stat/Promtail).
# Вывод самого агента пишется в <AGENT__REPORTSDIR>\logs — см. выше.
LOGS_DIR=D:\work\Artas2026\logs
