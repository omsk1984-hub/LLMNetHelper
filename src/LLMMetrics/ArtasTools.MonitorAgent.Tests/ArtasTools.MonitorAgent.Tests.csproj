<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>ArtasTools.MonitorAgent.Tests</AssemblyName>
    <RootNamespace>ArtasTools.MonitorAgent.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Core\ArtasTools.MonitorAgent.Core.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Context\ArtasTools.MonitorAgent.Context.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Infrastructure\ArtasTools.MonitorAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Llm\ArtasTools.MonitorAgent.Llm.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Roslyn\ArtasTools.MonitorAgent.Roslyn.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.CodeChange\ArtasTools.MonitorAgent.CodeChange.csproj" />
    <ProjectReference Include="..\ArtasTools.MonitorAgent.Agent\ArtasTools.MonitorAgent.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Фикстура Roslyn — отдельный проект с собственным Directory.Build.props.
      Исключаем её исходники из компиляции тестовой сборки, чтобы они
      не попали в общий вывод и не конфликтовали по namespace.
    -->
    <Compile Remove="Fixtures\**\*.cs" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

</Project>
