<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>LLMNetHelper.Tests</AssemblyName>
    <RootNamespace>LLMNetHelper.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMNetHelper.Abstractions\LLMNetHelper.Abstractions.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Core\LLMNetHelper.Core.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Context\LLMNetHelper.Context.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Infrastructure\LLMNetHelper.Infrastructure.csproj" />
    <ProjectReference Include="..\..\LLMCore\LLMCore.Llm\LLMCore.Llm.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Roslyn\LLMNetHelper.Roslyn.csproj" />
    <ProjectReference Include="..\LLMNetHelper.CodeChange\LLMNetHelper.CodeChange.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Agent\LLMNetHelper.Agent.csproj" />
    <ProjectReference Include="..\LLMNetHelper.GitLab\LLMNetHelper.GitLab.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Фикстура Roslyn — отдельный проект с собственным Directory.Build.props.
      Исключаем её исходники из компиляции тестовой сборки, чтобы они
      не попали в общий вывод и не конфликтовали по namespace.
    -->
    <Compile Remove="Fixtures\**\*.cs" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Версии соответствуют офлайн-кэшу NuGet (устраняет NU1603). -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

</Project>
