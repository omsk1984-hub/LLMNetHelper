<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      NuGet Audit отключён: окружение работает в офлайн-режиме.
    -->
    <NuGetAudit>false</NuGetAudit>

    <!--
      NU1605 (package downgrade) подавляется по конкретной причине:
      цепочка LLMNetHelper.Roslyn -> Microsoft.CodeAnalysis.Workspaces.MSBuild 4.14.0
      -> Microsoft.Build.Tasks.Core 17.14.28 требует System.CodeDom >= 9.0.0,
      а транзитивная ветка через Microsoft.Build.Locator приводит System.CodeDom 7.0.0.
      Пакет является только build-time зависимостью Roslyn и не попадает в рантайм агента.

      Причина, по которой подавление вводилось ранее (MEAI → System.Memory.Data 8.0.1),
      устранена миграцией MEAI на 10.5.0 (см. plans/6_meai-migration-10.5-plan.md).
    -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

</Project>
