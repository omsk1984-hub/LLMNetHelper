{
  "Agent": {
    "RunAtUtc": "03:00",
    "WindowHours": 24,
    "ReportsDir": "reports/monitoring",
    "DatabasePath": "reports/monitoring/facts.db",
    "RetentionDays": 90,
    "TopErrorsLimit": 25,
    "MaxSampleChars": 2000,
    "HealthPort": 8091,

    "Orchestration": {
      "Orchestrator": "native",
      "MaxSteps": 8,
      "ToolCallLimit": 30,
      "EnableFixPlanning": true,
      "DomainContext": ""
    }
  },

  "Loki": {
    "BaseUrl": "http://localhost:3100",
    "TimeoutSeconds": 30,
    "MaxEntries": 500
  },

  "Prometheus": {
    "BaseUrl": "http://localhost:9090",
    "TimeoutSeconds": 30
  },

  "Llm": {
    "Provider": "custom",
    "Endpoint": "https://plusvibeapi.ru/v1",
    "ApiKey": "",
    "Model": "qwen3.8-omni-flash",
    "MaxTokens": 4000,
    "Temperature": 0.1,
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  },

  "Context": {
    "Enabled": true,
    "TopK": 8,
    "MaxChars": 6000,
    "TotalCharsBudget": 24000,

    "Sources": {
      "local-folder": {
        "Path": "../../docs",
        "Include": [ "**/*.md" ],
        "Exclude": [
          "**/bin/**",
          "**/obj/**",
          "**/node_modules/**",
          "**/.git/**",
          "**/.env",
          "**/.env.*",
          "**/*.key",
          "**/*.pfx",
          "**/secrets*"
        ],
        "MaxFiles": 2000,
        "MaxFileBytes": 524288,
        "ChunkSize": 3000,
        "ChunkOverlap": 300
      }
    }
  },

  "Roslyn": {
    "Enabled": false,
    "SolutionPath": "src/LLMNetHelper/LLMNetHelper.slnx",
    "CompilationCacheSeconds": 300,
    "MaxSourceChars": 20000,
    "MaxSearchResults": 50
  },

  "CodeChange": {
    "Enabled": false,
    "RepositoryPath": ".",
    "BaseBranch": "main",
    "RequireCleanWorktree": true,
    "BuildTimeoutSeconds": 600,
    "TestTimeoutSeconds": 900,
    "SkipTests": false,
    "SolutionPath": "src/LLMNetHelper/LLMNetHelper.slnx",
    "GitExecutable": "git",
    "DotnetExecutable": "dotnet",
    "BranchPrefix": "fix/ai-"
  },

  "GitLab": {
    "Enabled": false,
    "ApiUrl": "https://github.com/omsk1984-hub/ArtasCollector.git",
    "GroupId": 0,
    "GroupName": "GPM/backend",
    "Token": "",
    "CloneRoot": "repos/GPM",
    "CloneTimeoutSeconds": 1800,
    "UpdateTimeoutSeconds": 120,
    "CloneDepth": 1,
    "TlsProtocols": "Tls12",
    "AllowLongPaths": true,
    "ExcludeArchived": true
  },

  "Chat": {
    "Include": [ "**/*.md", "**/*.cs", "**/*.csproj", "**/*.sln", "**/*.slnx",
                 "**/*.json", "**/*.sql", "**/*.yml", "**/*.yaml", "**/*.xml",
                 "**/*.txt", "**/*.py", "**/*.js", "**/*.ts" ],
    "TopK": 8,
    "MaxChars": 6000,
    "TotalCharsBudget": 24000,
    "MaxFiles": 20000,
    "MaxFileBytes": 524288,
    "ChunkSize": 3000,
    "ChunkOverlap": 300,
    "HistoryMessages": 20,
    "MaxSteps": 8,
    "ToolCallLimit": 30,
    "ListLimit": 200
  }
}
