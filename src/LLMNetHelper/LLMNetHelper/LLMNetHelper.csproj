<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LLMNetHelper</AssemblyName>
    <RootNamespace>LLMNetHelper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMNetHelper.Abstractions\LLMNetHelper.Abstractions.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Core\LLMNetHelper.Core.csproj" />
    <ProjectReference Include="..\..\LLMCore\LLMCore.Llm\LLMCore.Llm.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Infrastructure\LLMNetHelper.Infrastructure.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Context\LLMNetHelper.Context.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Roslyn\LLMNetHelper.Roslyn.csproj" />
    <ProjectReference Include="..\LLMNetHelper.CodeChange\LLMNetHelper.CodeChange.csproj" />
    <ProjectReference Include="..\LLMNetHelper.Agent\LLMNetHelper.Agent.csproj" />
    <ProjectReference Include="..\LLMNetHelper.GitLab\LLMNetHelper.GitLab.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Версии соответствуют офлайн-кэшу NuGet (см. nuget.config): точные
         совпадения запрошенных версий в кэше отсутствуют, и NuGet поднимает
         их с варнингом NU1603. Фиксация имеющихся версий убирает варнинги. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Транзитивная зависимость Microsoft.Extensions.FileProviders.Physical 10.0.0
         требует FileSystemGlobbing >= 10.0.0; в кэше только 10.0.8 -> NU1603.
         Прямая ссылка унифицирует граф на 10.0.8 без варнинга. -->
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
