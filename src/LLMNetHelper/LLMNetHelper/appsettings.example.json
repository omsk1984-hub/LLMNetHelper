{
  "_comment": "Шаблон конфигурации. Относительные пути здесь разрешаются от РАБОЧЕГО КАТАЛОГА ПРОЦЕССА (для `dotnet run` из каталога проекта это <репозиторий>/src/LLMNetHelper/LLMNetHelper). Запуск через run_LLMNetHelper.ps1 нормализует относительные пути от корня репозитория — см. .env.example.",

  "Agent": {
    "RunAtUtc": "03:00",
    "WindowHours": 24,
    "ReportsDir": "../../../../reports/monitoring",
    "DatabasePath": "../../../../reports/monitoring/facts.db",
    "RetentionDays": 90,
    "TopErrorsLimit": 25,
    "MaxSampleChars": 2000,
    "HealthPort": 8091,

    "Orchestration": {
      "Orchestrator": "native",
      "MaxSteps": 8,
      "ToolCallLimit": 30,
      "EnableFixPlanning": true,

      "_commentDomain": "Предметное описание анализируемой системы для системного промпта. Пусто -> нейтральная формулировка, гипотезы только по фактам сводки и документации.",
      "DomainContext": ""
    }
  },
  "Loki": {
    "BaseUrl": "http://loki:3100",
    "TimeoutSeconds": 30,
    "MaxEntries": 500
  },
  "Prometheus": {
    "BaseUrl": "http://prometheus:9090",
    "TimeoutSeconds": 30
  },
  "Llm": {
    "Provider": "custom",
    "Endpoint": "",
    "ApiKey": "",
    "Model": "gpt-4.1-mini",
    "MaxTokens": 4000,
    "Temperature": 0.1,
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  },
  "Context": {
    "Enabled": true,
    "TopK": 8,
    "MaxChars": 6000,
    "TotalCharsBudget": 24000,

    "Sources": {
      "local-folder": {
        "Path": "../../../../docs",
        "Include": [ "**/*.md" ],
        "Exclude": [
          "**/bin/**",
          "**/obj/**",
          "**/node_modules/**",
          "**/.git/**",
          "**/.env",
          "**/.env.*",
          "**/*.key",
          "**/*.pfx",
          "**/secrets*"
        ],
        "MaxFiles": 2000,
        "MaxFileBytes": 524288,
        "ChunkSize": 3000,
        "ChunkOverlap": 300
      }
    }
  },
  "Roslyn": {
    "Enabled": false,
    "SolutionPath": "",
    "CompilationCacheSeconds": 300,
    "MaxSourceChars": 20000,
    "MaxSearchResults": 50
  },
  "CodeChange": {
    "Enabled": false,
    "RepositoryPath": "",
    "BaseBranch": "main",
    "RequireCleanWorktree": true,
    "BuildTimeoutSeconds": 600,
    "TestTimeoutSeconds": 900,
    "SkipTests": false,
    "SolutionPath": "",
    "GitExecutable": "git",
    "DotnetExecutable": "dotnet",
    "BranchPrefix": "fix/ai-"
  }
}
