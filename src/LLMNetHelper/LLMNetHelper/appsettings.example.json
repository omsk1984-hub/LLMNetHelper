{
  // =============================================================================
  // LLMNetHelper — шаблон конфигурации (appsettings.example.json)
  // =============================================================================
  // Копирование в рабочий файл:
  //   Copy-Item appsettings.example.json appsettings.json
  //
  // Относительные пути здесь разрешаются от РАБОЧЕГО КАТАЛОГА ПРОЦЕССА
  // (для `dotnet run` из каталога проекта — это <репозиторий>/src/LLMNetHelper/
  //  LLMNetHelper). Запуск через run_LLMNetHelper.ps1 нормализует относительные
  //  пути от корня репозитория.
  //
  // ПРИОРИТЕТ КОНФИГУРАЦИИ (от высшего к низшему):
  //   1. Переменные окружения (KEY=value / AGENT__WINDOWHOURS=24)
  //   2. appsettings.json (переопределяет .env.example молча)
  //   3. Дефолты в коде (Options-классы)
  //
  // ЭТОТ ФАЙЛ — ЕДИНСТВЕННЫЙ ШАБЛОН НЕ-СЕКРЕТНОЙ КОНФИГУРАЦИИ В РЕПОЗИТОРИИ.
  // Креды (API-ключи) — только в .env (см. src/LLMNetHelper/.env.example).
  // =============================================================================

  "Agent": {
    "RunAtUtc": "03:00",
    "WindowHours": 24,
    "ReportsDir": "reports/monitoring",
    "DatabasePath": "reports/monitoring/facts.db",
    "RetentionDays": 90,
    "TopErrorsLimit": 25,
    "MaxSampleChars": 2000,
    "HealthPort": 8091,

    "Orchestration": {
      "Orchestrator": "native",
      "MaxSteps": 8,
      "ToolCallLimit": 30,
      "EnableFixPlanning": true,

      // Предметное описание анализируемой системы для системного промпта.
      // Пусто -> нейтральная формулировка, гипотезы только по фактам сводки
      // и документации. Пример непустого:
      //   "Система — приём тиков (gRPC) -> PostgreSQL, логи в Loki."
      "DomainContext": ""
    }
  },

  "Loki": {
    // На хосте: http://localhost:3100. В Docker: http://loki:3100.
    "BaseUrl": "http://localhost:3100",
    "TimeoutSeconds": 30,
    "MaxEntries": 500
  },

  "Prometheus": {
    // На хосте: http://localhost:9090. В Docker: http://prometheus:9090.
    "BaseUrl": "http://localhost:9090",
    "TimeoutSeconds": 30
  },

  "Llm": {
    "Provider": "custom",
    // Базовый URL провайдера. Клиент постит на "/v1/chat/completions".
    // Примеры:
    //   https://api.openai.com
    //   https://openrouter.ai/api
    //   http://localhost:11434/v1    (Ollama)
    //   http://localhost:1234/v1     (LM Studio)
    //   https://gigacode.ru/api/openai/v1  (GigaCode)
    "Endpoint": "",
    // API-ключ — СЕКРЕТ. Кладите только в .env, никогда не коммитьте.
    // См. .env.example для настройки через переменную окружения.
    "ApiKey": "",
    "Model": "qwen3.8-omni-flash",
    "MaxTokens": 4000,
    "Temperature": 0.1,
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  },

  "Context": {
    "Enabled": true,
    "TopK": 8,
    "MaxChars": 6000,
    "TotalCharsBudget": 24000,

    "Sources": {
      "local-folder": {
        // Относительный путь разрешается от рабочего каталога процесса.
        "Path": "../../docs",
        "Include": [ "**/*.md" ],
        "Exclude": [
          "**/bin/**",
          "**/obj/**",
          "**/node_modules/**",
          "**/.git/**",
          "**/.env",
          "**/.env.*",
          "**/*.key",
          "**/*.pfx",
          "**/secrets*"
        ],
        "MaxFiles": 2000,
        "MaxFileBytes": 524288,
        "ChunkSize": 3000,
        "ChunkOverlap": 300
      }
    }
  },

  "Roslyn": {
    // Безопасный дефолт — false: агент продолжает диагностику без инструментов
    // чтения кода. Включается флагом: run_LLMNetHelper.ps1 -Roslyn
    "Enabled": false,
    "SolutionPath": "src/LLMNetHelper/LLMNetHelper.slnx",
    "CompilationCacheSeconds": 300,
    "MaxSourceChars": 20000,
    "MaxSearchResults": 50
  },

  "CodeChange": {
    // Безопасный дефолт — false. Включается флагом:
    // run_LLMNetHelper.ps1 -CodeChange
    "Enabled": false,
    "RepositoryPath": ".",
    "BaseBranch": "main",
    "RequireCleanWorktree": true,
    "BuildTimeoutSeconds": 600,
    "TestTimeoutSeconds": 900,
    "SkipTests": false,
    "SolutionPath": "src/LLMNetHelper/LLMNetHelper.slnx",
    "GitExecutable": "git",
    "DotnetExecutable": "dotnet",
    "BranchPrefix": "fix/ai-"
  },

  // -----------------------------------------------------------------------------
  // Режим чата (--chat): консольное общение с LLM по вопросам из каталога
  // скачанных репозиториев (GitLab:CloneRoot). Hosted-сервисы (health/планировщик)
  // в этом режиме стартуют всегда — наблюдаемость сохраняется.
  // -----------------------------------------------------------------------------
  "Chat": {
    // Glob-шаблоны файлов, по которым ищет чат (код + документы).
    "Include": [ "**/*.md", "**/*.cs", "**/*.csproj", "**/*.sln", "**/*.slnx",
                 "**/*.json", "**/*.sql", "**/*.yml", "**/*.yaml", "**/*.xml",
                 "**/*.txt", "**/*.py", "**/*.js", "**/*.ts" ],
    // Сколько фрагментов (чанков) подмешивать в промпт на один вопрос.
    "TopK": 8,
    // Максимальная длина одного фрагмента в символах.
    "MaxChars": 6000,
    // Общий бюджет символов контекста на один вопрос.
    "TotalCharsBudget": 24000,
    // Максимум файлов, просматриваемых за один поиск (обход всего CloneRoot
    // при 100+ репозиториях — ограничьте или сузьте область /repo <имя>).
    "MaxFiles": 20000,
    // Максимальный размер файла в байтах; более крупные пропускаются.
    "MaxFileBytes": 524288,
    // Размер чанка и перекрытие при нарезке длинных файлов.
    "ChunkSize": 3000,
    "ChunkOverlap": 300,
    // Сколько сообщений диалога держать в истории (обрезка по парам).
    "HistoryMessages": 20,
    // Лимиты агентского цикла (/tools): итерации ReAct и вызовы инструментов.
    "MaxSteps": 8,
    "ToolCallLimit": 30,
    // Максимум файлов, возвращаемых инструментом repo_list_files.
    "ListLimit": 200,
    // Markdown-транскрипт диалога: один файл на весь сеанс (от запуска до
    // /exit/EOF) — вопросы, команды, шаги ReAct (ответ модели -> вызов
    // инструмента -> полный результат), финальные ответы, лимиты/сбои.
    "DialogLog": {
      // false — транскрипт не пишется.
      "Enabled": true,
      // Каталог транскриптов; относительный путь раннер нормализует
      // от корня репозитория (переменная CHAT__DIALOGLOG__DIRECTORY).
      "Directory": "logs/dialogs",
      // Писать ли полный текст BM25-фрагментов контекста (режим без /tools) —
      // ровно то, что видела модель. false — только аннотации (заголовок,
      // score, длина, путь). Объём ограничен Chat:TopK/MaxChars/TotalCharsBudget.
      "IncludeContextFragments": true
    }
  },

  "GitLab": {
    // Безопасный дефолт — false. Включается через appsettings.json или .env
    // (GITLAB__ENABLED), либо флагом раннера -CloneAll (включает только на запуск).
    // Токен можно задать через переменную окружения GITLAB__TOKEN.
    "Enabled": false,
    "ApiUrl": "https://github.com/omsk1984-hub/ArtasCollector.git",
    // GroupId=0 — ID группы резолвится из API по GroupName (полный путь группы).
    "GroupId": 0,
    "GroupName": "GPM/backend",
    "Token": "",
    "CloneRoot": "repos/GPM",
    "CloneTimeoutSeconds": 300,
    "UpdateTimeoutSeconds": 120,
    "CloneDepth": 1,
    // Ограничение протоколов TLS для API. Пусто — системный выбор.
    // "Tls12" требуется на хостах, где TLS 1.3 в SChannel падает при рукопожатии
    // с этим GitLab (Win32Exception 0x80004005). Раннер ставит Tls12 по умолчанию.
    "TlsProtocols": "Tls12",
    // core.longpaths=true для процессов git: в группе есть репозитории с путями
    // > 260 символов, без флага checkout падает с "File name too long".
    "AllowLongPaths": true,
    // Исключать архивные проекты группы при клонировании/перечислении.
    // В GPM/backend архивных 43 из 103. Фильтр серверный (archived=false) плюс
    // клиентская страховка, потому что exclude_archived=true на GitLab 19.2.9
    // игнорируется.
    "ExcludeArchived": true
  }
}
