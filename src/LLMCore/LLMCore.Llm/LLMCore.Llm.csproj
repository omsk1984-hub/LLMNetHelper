<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LLMCore.Llm</AssemblyName>
    <RootNamespace>LLMCore.Llm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLMCore.Abstractions\LLMCore.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageReference Include="System.Memory.Data" Version="10.0.3" />
    <!-- Microsoft.Extensions.AI.OpenAI удалён: транспорт собственный
         (CustomOpenAiCompatibleClient), OpenAI-SDK-адаптер не используется. -->
    <!-- FrameworkReference Microsoft.AspNetCore.App заменён точечными пакетами:
         библиотека ядра не должна зависеть от shared framework ASP.NET Core.
         Все версии 10.0.0 присутствуют в офлайн-кэше (план 15, §2). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
