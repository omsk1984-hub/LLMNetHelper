  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LLMNetHelper\LLMNetHelper.Abstractions\LLMNetHelper.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
