<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Общие LLM-контракты ядра (LLMCore). Зависимостей нет: проект не знает
    ни о продукте (LLMNetHelper.*), ни о транспортах (LLMCore.Llm).
    Направление зависимостей строго вниз:
      LLMCore.Llm -> LLMCore.Abstractions
      LLMNetHelper.* -> LLMCore.Abstractions (через ссылку на LLMCore.Llm)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LLMCore.Abstractions</AssemblyName>
    <RootNamespace>LLMCore.Abstractions</RootNamespace>
  </PropertyGroup>

</Project>
