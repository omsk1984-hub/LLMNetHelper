# =============================================================================
# LLMNetHelper — Docker-развёртывание
# =============================================================================
# Отличие от хостового запуска (src/LLMNetHelper/.env.example):
#   * Loki/Prometheus — по ИМЕНАМ СЕРВИСОВ общей docker-сети, не localhost;
#   * каталоги — внутри контейнера (/reports/monitoring, /docs),
#     смонтированы с хоста;
#   * Roslyn/CodeChange ВЫКЛЮЧЕНЫ: в runtime-образе нет MSBuild SDK.
#
# Использование:
#   Copy-Item deploy/monitor-agent/monitor-agent.env.example `
#             deploy/monitor-agent/monitor-agent.env
#   # вписать LLM__APIKEY, затем:
#   docker compose -f deploy/monitor-agent/docker-compose.monitor-agent.yml up -d --build
#
# Сеть: по умолчанию monitoring_artas_monitoring (external). Переопределяется
# переменной MONITORING_NETWORK (см. docker-compose.monitor-agent.yml).
# =============================================================================

LLM__PROVIDER=custom
LLM__ENDPOINT=https://api.openai.com
LLM__APIKEY=ЗАМЕНИТЕ_НА_КЛЮЧ
LLM__MODEL=qwen3.8-omni-flash

# Предметное описание системы для промпта (пусто -> нейтральный промпт).
AGENT__ORCHESTRATION__DOMAINCONTEXT=

AGENT__RUNATUTC=03:00
AGENT__WINDOWHOURS=24
